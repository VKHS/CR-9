{
 "display": "supplementary:Table S8",
 "source": {"document": "supplementary", "pages": [5, 6]},
 "scope": "Measurement names, formulas, per-coordinate transforms and targeted failures. The coordinates of each row (and hence its dimension) are those of the MeasurementBank schema in cross_morse/core.py; 'kind' states how the runtime refreshes them (cheap: every measurement; spectral: acquired at the sensing period; reach: recomputed every measurement from the last acquired powers; age: appended when the sensing period exceeds one; observer: computed by the observer, not by the sensor). The robust z-score itself is the normalization recorded by cross_morse/learning.py.",
 "rows": {
  "entropy": {"measurement": "entropy", "coordinates": ["entropy"], "kind": "cheap",
              "formula": "−Σ_c p_c log p_c / log C or mean binary entropy", "transform": "training-fold median/MAD; clip",
              "failure": "low confidence"},
  "margin": {"measurement": "margin", "coordinates": ["margin"], "kind": "cheap",
             "formula": "p(1) − p(2) or mean 2|p_c − 0.5|", "transform": "robust z-score", "failure": "ambiguity"},
  "source_disagreement": {"measurement": "source-current disagreement", "coordinates": ["source_js"], "kind": "cheap",
                          "formula": "Jensen–Shannon divergence of frozen/current predictions",
                          "transform": "divide by log 2; robust z-score", "failure": "representation drift"},
  "effective_rank": {"measurement": "effective rank", "coordinates": ["effective_rank_entropy"], "kind": "cheap",
                     "formula": "entropy of normalized singular values; frozen randomized-SVD seed",
                     "transform": "[0, 1]", "failure": "global collapse"},
  "dirichlet": {"measurement": "Dirichlet energy", "coordinates": ["log1p_dirichlet"], "kind": "cheap",
                "formula": "tr(Hᵀ L_sym H)/(‖H‖_F² + ε)", "transform": "log(1 + x); robust z-score",
                "failure": "local variation loss"},
  "band_power": {"measurement": "band power", "coordinate_prefix": "band_power_", "kind": "spectral",
                 "formula": "p_ℓb from main Eq. (11)", "transform": "six fixed windows; three retained bands",
                 "failure": "spectral relocation"},
  "source_alignment": {"measurement": "source alignment", "coordinate_prefix": "source_alignment_", "kind": "spectral",
                       "formula": "c_ℓb from main Eq. (11)", "transform": "zero-denominator floor ε",
                       "failure": "task-band attenuation"},
  "innovation": {"measurement": "innovation/NIS", "kind": "observer",
                 "formula": "e_ℓᵀ S_ℓ⁻¹ e_ℓ and residual moments", "transform": "training-fold calibration",
                 "failure": "observer inconsistency"},
  "transport_history": {"measurement": "transport history", "coordinates": ["normalized_mass", "normalized_hops", "relative_depth"],
                        "kind": "cheap", "formula": "accumulated mass, expected range and relative depth",
                        "transform": "registered depth normalization", "failure": "exposure ambiguity"},
  "degree_weighted": {"measurement": "degree-weighted band power", "coordinate_prefix": "degree_weighted_power_", "kind": "spectral",
                      "formula": "p_ℓb of main Eq. (11) evaluated on D^1/2 H_ℓ (the quantity of Proposition 6 for the row-stochastic realization)",
                      "transform": "as band power", "failure": "bound quantity on irregular graphs (E7, E18)"},
  "spectral_age": {"measurement": "spectral age (when P_s > 1)", "coordinates": ["spectral_age_fraction"], "kind": "age",
                   "formula": "(ℓ − ℓ_last)/P_s", "transform": "explicit observed age", "failure": "stale-feature identification"},
  "state_energy": {"measurement": "total state energy", "coordinates": ["log_state_energy"], "kind": "cheap",
                   "formula": "‖H_ℓ‖_F²", "transform": "log; robust z-score", "failure": "required by the displacement bound"},
  "reachability": {"measurement": "reachability statistic", "coordinate_prefix": "reachability_A", "kind": "reach",
                   "formula": "ŝ_a(H_ℓ) = [Σ_b s_ab² ‖G_b H_ℓ‖_F²]^1/2 per registered action, with s_ab from the registry (Fig. S15b)",
                   "transform": "robust z-score", "failure": "action-specific reachable displacement (E18)"}
 }
}
