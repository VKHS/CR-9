# CROSS-MORSE site profile for the NAISS Arrhenius cluster (NVIDIA GH200 nodes).
#
# The SITE SETTINGS block of run_cross_morse.sh already holds the Arrhenius
# setting the authors use: partition `gpu`, one GH200 per job (`--gpus=1`), 16
# CPU threads, aarch64 nodes, the modules GPU/buildenv-nvhpc/25.9-cu13.0 and
# GPU/Python/3.13.5-bare-gcc-2025b-eb, the persistent environment
# venv_arrhenius_gh200 with the CUDA 13 PyTorch wheel, and the project-disk
# layout below. Only the two identifiers of an allocation are missing; they
# belong in a private copy of this file, never in the repository:
#
#   cp configs/arrhenius-site.env.example configs/arrhenius.env.example   # git-ignored
#   $EDITOR configs/arrhenius.env.example                                 # fill the two values
#   bash run_cross_morse.sh check                                         # discovers the copy
#   bash run_cross_morse.sh reproduce
#
# The launcher finds configs/arrhenius.env.example next to itself; a copy kept
# elsewhere is selected with CM_ENV_FILE=/absolute/path. Exported CM_* values
# override this file, and this file overrides the SITE SETTINGS block, so the
# launcher stays byte-identical to the released file. docs/HPC.md has the guide.

# Slurm account of the GPU allocation: the NAISS project id with its -gpu suffix.
CM_ACCOUNT=""
# NAISS storage project that owns the project disk. With it set, all suites,
# logs, caches, datasets and the environment live under
# /nobackup/proj/disk/<storage project>/cross_morse on the shared project disk.
CM_STORAGE_PROJECT=""
