# CROSS-MORSE site profile template for any Slurm GPU cluster.
#
# Two equivalent ways to point the launcher at your cluster:
#   1. edit the SITE SETTINGS block at the top of run_cross_morse.sh, or
#   2. copy this file outside the repository, fill it, and select it:
#        cp configs/public.env.example "$HOME/cross_morse_site.env"
#        $EDITOR "$HOME/cross_morse_site.env"
#        export CM_ENV_FILE="$HOME/cross_morse_site.env"
#        bash run_cross_morse.sh check
#      The launcher then stays byte-identical to the released file.
# Exported CM_* values override this profile; this profile overrides the SITE
# SETTINGS block; a key left out here keeps the SITE SETTINGS value. The file is
# trusted Bash, sourced by the launcher.

# -- scheduler ---------------------------------------------------------------------
CM_ACCOUNT=""                     # Slurm account (sbatch --account); required to submit
CM_PARTITION="gpu"                # GPU partition
CM_GPU_REQUEST="--gpus=1"         # how this site requests one GPU, e.g. "--gres=gpu:1"
CM_THREADS=16                     # CPU threads per job (sbatch --cpus-per-task)
CM_MEM=""                         # memory per job, e.g. 120G; empty: the site default
CM_SBATCH_EXTRA=""                # further options for every job, e.g. "--qos=normal --constraint=a100"

# -- storage ---------------------------------------------------------------------
# Work root on storage visible from the compute nodes: suites, logs, caches,
# the dataset cache (CM_DATA_ROOT) and the environment (CM_VENV_DIR).
CM_BASE="${HOME}/cross_morse_work"

# -- software ----------------------------------------------------------------------
CM_BUILD_MODULE=""                # environment modules to load; empty: keep the job's environment
CM_PYTHON_MODULE=""
CM_EXPECT_ARCH=""                 # aarch64 or x86_64 to enforce the node architecture; empty: any
CM_VENV_NAME="venv_cross_morse"   # created once by the setup job under CM_BASE/code
# PyTorch wheel the setup job installs when the environment has none; choose the
# CUDA build that matches the node driver (https://pytorch.org/get-started/).
CM_TORCH_SPEC="torch"
CM_TORCH_INDEX="https://download.pytorch.org/whl/cu128"

# -- wall time ---------------------------------------------------------------------
# Full-profile jobs that reach their limit checkpoint and requeue themselves, so
# the limit sets the length of one job. Per dataset: CM_TIME_ARXIV, CM_TIME_PRODUCTS, ...
CM_TIME_FULL="24:00:00"
